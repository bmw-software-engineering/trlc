package MdPlainArrayTest

type Item {
  description String
}

enum Mode {
  Fast
  Slow
}

type RequirementPlain {
  description String
  numbers     Integer [1 .. *]
  levels      Decimal [1 .. *]
  flags       Boolean [1 .. *]
  tags        String  [1 .. *]
  modes       Mode    [1 .. *]
  refs        Item    [1 .. *]
}
