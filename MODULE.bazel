module(
    name = "trlc",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(
    name = "rules_python",
    version = "1.1.0",
)

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.2.1.1",
    dev_dependency = True,
)
bazel_dep(
    name = "aspect_rules_lint",
    version = "2.2.0",
    dev_dependency = True,
)

# Patch aspect_rules_lint to add TRLC (.trlc / .rsl) support in the format shell script.
single_version_override(
    module_name = "aspect_rules_lint",
    patch_strip = 1,
    patches = [
        "//third_party/format:add_trlc_support.patch",
    ],
)

##################################################
### Setup TRLC Formatter
##################################################
bazel_dep(
    name = "bazel_skylib",
    version = "1.8.2",
    dev_dependency = True,
)
bazel_dep(
    name = "aspect_rules_js",
    version = "2.9.2",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_multirun",
    version = "0.13.0",
    dev_dependency = True,
)

npm = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "npm",
    dev_dependency = True,
)
npm.npm_translate_lock(
    name = "npm_trlc",
    data = [
        "//tools/formatter:package.json",
    ],
    npmrc = "//tools/formatter:.npmrc",
    pnpm_lock = "//tools/formatter:pnpm-lock.yaml",
    update_pnpm_lock = False,
)
use_repo(npm, "npm_trlc")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.9")
python.toolchain(python_version = "3.10")
python.toolchain(python_version = "3.11")
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_versions")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

[
    pip.parse(
        hub_name = "trlc_dependencies",
        python_version = "3.{}".format(python_version),
        requirements_lock = "//:requirements_lock_3_{}.txt".format(python_version),
    )
    for python_version in [
        "9",
        "10",
        "11",
        "12",
    ]
]

use_repo(pip, "trlc_dependencies")

[
    pip.parse(
        hub_name = "trlc_sphinx_dependencies",
        python_version = "3.{}".format(python_version),
        requirements_lock = "//tools/sphinx:requirements_3_{}.txt".format(python_version),
    )
    for python_version in [
        "9",
        "10",
        "11",
        "12",
    ]
]

use_repo(pip, "trlc_sphinx_dependencies")

# Dev-only pip hub: tools required for linting, static analysis, etc.
pip_dev = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
    dev_dependency = True,
)
pip_dev.parse(
    hub_name = "trlc_dev_dependencies",
    python_version = "3.12",
    requirements_lock = "//:requirements_dev_lock.txt",
)
use_repo(pip_dev, "trlc_dev_dependencies")
